# Copy to .env next to docker-compose.yml, fill in, then: chmod 600 .env
# Never commit the real file.

# --- Public address ---------------------------------------------------------
# VPS:   bookingmngr.duckdns.org   (no scheme -> Caddy gets a Let's Encrypt cert)
# Local: http://localhost          (plain HTTP, no ACME, identical routing)
SITE_ADDRESS=http://localhost
ACME_EMAIL=you@example.com

# --- Images -----------------------------------------------------------------
# Leave unset to build from source. On the VPS, pin the git SHA you built and
# pushed, so a rollback is just editing these two lines.
# BACKEND_IMAGE=ghcr.io/<user>/bookingmngr-backend:<git-sha>
# FRONTEND_IMAGE=ghcr.io/<user>/bookingmngr-frontend:<git-sha>

# --- Database ---------------------------------------------------------------
POSTGRES_USER=bookingmngr
POSTGRES_DB=bookingmngr
# openssl rand -base64 24
# Changing this later needs an ALTER ROLE — pick it once.
POSTGRES_PASSWORD=

# --- App --------------------------------------------------------------------
# openssl rand -base64 48 | tr -d '\n'
# Changing it invalidates every existing session.
SECRET_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Bootstrap only: read when the account does not yet exist. Once the owner has
# signed in and changed their password in the UI, blank this value out.
OWNER_USERNAME=owner
OWNER_EMAIL=
OWNER_PASSWORD=
# Quoted so the file is also safe to `source` from a shell.
DEFAULT_ORGANIZATION_NAME="My Properties"

# --- Backups ----------------------------------------------------------------
BACKUP_RETENTION_DAYS=14
BACKUP_HOUR=3
BACKUP_MINUTE=15

TZ=Europe/Sofia
