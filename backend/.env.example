# Copy to .env and adjust.

ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=INFO

DATABASE_URL=postgresql+psycopg://bookingmngr:bookingmngr@localhost:5432/bookingmngr
DB_ECHO=false

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Bootstrap owner account, created by `python -m app.db.init_db`.
OWNER_USERNAME=owner
OWNER_PASSWORD=changeme
OWNER_EMAIL=owner@example.com
DEFAULT_ORGANIZATION_NAME=My Properties

CORS_ORIGINS=["http://localhost:3000"]

DEFAULT_CURRENCY=EUR
DEFAULT_TIMEZONE=Europe/Sofia
DEFAULT_CLEANING_DURATION_MINUTES=60
